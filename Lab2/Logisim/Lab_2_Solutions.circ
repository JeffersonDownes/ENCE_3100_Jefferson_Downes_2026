    <comp name="Text" loc="(70,40)" lib="9">
      <a name="text" val="ONE-DIGIT BCD ADDER" />
      <a name="font" val="SansSerif bold 22" />
      <a name="halign" val="left" />
    </comp>
    <comp name="Text" loc="(70,70)" lib="9">
      <a name="text" val="A + B + cin = 0..19. Add 6 to the raw low nibble when decimal carry k is asserted." />
