  <circuit name="Part_IV">
    <a name="appearance" val="logisim_evolution" />
    <a name="circuit" val="Part_IV" />
    <a name="circuitnamedboxfixedsize" val="true" />
    <comp name="Text" loc="(70,40)" lib="9">
      <a name="text" val="PART IV  |  One-digit BCD addition" />
      <a name="font" val="SansSerif bold 22" />
      <a name="halign" val="left" />
    </comp>
    <comp name="Text" loc="(70,70)" lib="9">
      <a name="text" val="SW7..4 = A, SW3..0 = B, SW8 = cin. HEX6 + HEX4 + cin = HEX1 HEX0. LEDG8 flags invalid BCD input." />
      <a name="font" val="SansSerif plain 13" />
      <a name="halign" val="left" />
