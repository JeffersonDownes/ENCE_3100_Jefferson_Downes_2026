set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY accumulator_8bit
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_FILE ../../accumulator_8bit.v
set_global_assignment -name SDC_FILE accumulator_sim.sdc
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Altera FPGA (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_location_assignment PIN_B8 -to Reset_n
set_location_assignment PIN_A7 -to Clk
set_location_assignment PIN_A8 -to S[0]
set_location_assignment PIN_A9 -to S[1]
set_location_assignment PIN_A10 -to S[2]
set_location_assignment PIN_B10 -to S[3]
set_location_assignment PIN_D13 -to S[4]
set_location_assignment PIN_C13 -to S[5]
set_location_assignment PIN_E14 -to S[6]
set_location_assignment PIN_D14 -to S[7]
set_location_assignment PIN_A11 -to Overflow
set_location_assignment PIN_C10 -to A[0]
set_location_assignment PIN_C11 -to A[1]
set_location_assignment PIN_D12 -to A[2]
set_location_assignment PIN_C12 -to A[3]
set_location_assignment PIN_A12 -to A[4]
set_location_assignment PIN_B12 -to A[5]
set_location_assignment PIN_A13 -to A[6]
set_location_assignment PIN_A14 -to A[7]
set_location_assignment PIN_B14 -to add_sub
set_instance_assignment -name IO_STANDARD "3.3 V SCHMITT TRIGGER" -to Reset_n
set_instance_assignment -name IO_STANDARD "3.3 V SCHMITT TRIGGER" -to Clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to S[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to S[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to S[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to S[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to S[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to S[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to S[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to S[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Overflow
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to A[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to A[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to A[2]
